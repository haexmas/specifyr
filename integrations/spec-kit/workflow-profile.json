{
  "schema": "spec-logic-workflow-profile-v1",
  "id": "org.spec-logic.github-speckit",
  "artifacts": [
    {"role": "specification", "discover": "specs/**/spec.md", "adapter": "speckit-v1"},
    {"role": "plan", "discover": "specs/**/plan.md", "adapter": "speckit-v1"},
    {"role": "tasks", "discover": "specs/**/tasks.md", "adapter": "speckit-v1"},
    {"role": "decision", "discover": "docs/adr/*.md", "adapter": "adr-v1"}
  ],
  "gates": [
    {"after": "specify", "checks": ["core:references-resolve", "core:ambiguity-reviewed"]},
    {"after": "plan", "checks": ["core:active-claims-satisfiable", "core:references-active"]},
    {"after": "tasks", "checks": ["core:active-requirement-covered", "core:dependencies-acyclic"]}
  ]
}

