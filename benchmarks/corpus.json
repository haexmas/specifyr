      "id": "haex-constitution-cardinality-conflict",
      "description": "An accepted ADR requires one contributor while an active spec requires two or more.",
      "expected_categories": ["contradiction"],
      "expected_rule_ids": ["core:active-claims-satisfiable"],
      "documents": [
        {
          "path": "docs/adr/0010.md",
          "content": "# ADR 0010\n\n**Status**: Accepted\n\nA project adopts exactly one constitution-contributing molecule.\n"
        },
        {
          "path": "specs/011/spec.md",
          "content": "# Spec 011\n\nThe workflow contribution participates in a multi-source merge requiring multiple contributing molecules.\n"
        }
      ],
      "model": {
        "schema": "spec-logic-model-v1",
        "metadata": {"case": "haex-constitution-cardinality-conflict"},
        "artifacts": [],
        "claims": [
          {
            "id": "haex:ADR-0010/D1",
            "kind": "decision",
            "modality": "must",
            "polarity": "positive",
            "subject": "haex:project",
            "predicate": "haex:constitution-contributor-count",
            "operator": "exactly",
            "value": 1,
            "scope": {"project": "haex-hive"},
            "status": "accepted",
            "source": {"path": "docs/adr/0010.md", "anchor": "decision"},
            "provenance": {"method": "asserted", "confidence": "authoritative"}
          },
          {
            "id": "haex:SPEC-011/FR-004",
            "kind": "requirement",
            "modality": "must",
            "polarity": "positive",
            "subject": "haex:project",
            "predicate": "haex:constitution-contributor-count",
            "operator": "at_least",
            "value": 2,
            "scope": {"project": "haex-hive"},
            "status": "active",
            "source": {"path": "specs/011/spec.md", "anchor": "FR-004"},
            "provenance": {"method": "asserted", "confidence": "authoritative"}
          }
        ],
        "relations": [],
        "closed_world": []
      }
    },
