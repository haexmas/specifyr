{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-logic.dev/schemas/finding.v1.schema.json",
  "title": "spec-logic Finding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "rule_id", "category", "severity", "message", "evidence", "details"],
  "properties": {
    "id": {"type": "string", "pattern": "^finding:[0-9a-f]{12}$"},
    "rule_id": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "severity": {"enum": ["error", "warning", "info"]},
    "message": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "details": {"type": "object"}
  }
}

