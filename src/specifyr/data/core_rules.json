{
  "schema": "specifyr-rule-pack-v1",
  "id": "org.specifyr.core",
  "version": "0.1.0",
  "rules": [
    {
      "id": "core:active-claims-satisfiable",
      "kind": "contradictory_claims",
      "category": "contradiction",
      "severity": "error",
      "rationale": "Simultaneously active normative claims in the same scope must have a common model.",
      "params": {}
    },
    {
      "id": "core:references-active",
      "kind": "references_active",
      "category": "stale_reference",
      "severity": "error",
      "rationale": "Active delivery relations must not rely on retired decisions or artifacts.",
      "params": {
        "predicates": ["core:depends_on", "core:implements", "core:refines", "core:verifies"]
      }
    },
    {
      "id": "core:active-requirement-covered",
      "kind": "relation_coverage",
      "category": "missing_coverage",
      "severity": "error",
      "rationale": "In a declared complete verification scope every active requirement needs evidence.",
      "params": {
        "claim_kind": "requirement",
        "relation": "core:verifies"
      }
    },
    {
      "id": "core:dependencies-acyclic",
      "kind": "acyclic",
      "category": "dependency_cycle",
      "severity": "error",
      "rationale": "Execution dependencies must admit a topological order.",
      "params": {
        "relation": "core:depends_on"
      }
    },
    {
      "id": "core:references-resolve",
      "kind": "unresolved_references",
      "category": "unresolved_reference",
      "severity": "error",
      "rationale": "Formal relations are meaningful only when both endpoints resolve.",
      "params": {}
    },
    {
      "id": "core:ambiguity-reviewed",
      "kind": "ambiguous_claim",
      "category": "ambiguity",
      "severity": "warning",
      "rationale": "Ambiguous inferred claims require review before they can become authoritative.",
      "params": {}
    }
  ]
}
