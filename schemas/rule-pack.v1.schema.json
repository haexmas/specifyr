{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-logic.dev/schemas/rule-pack.v1.schema.json",
  "title": "spec-logic Rule Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "rules"],
  "properties": {
    "schema": {"const": "spec-logic-rule-pack-v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "category", "severity", "rationale", "params"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": ["contradictory_claims", "references_active", "relation_coverage", "acyclic", "unresolved_references", "ambiguous_claim"]
          },
          "category": {"type": "string", "minLength": 1},
          "severity": {"enum": ["error", "warning", "info"]},
          "rationale": {"type": "string", "minLength": 1},
          "params": {"type": "object"}
        }
      }
    }
  }
}
